# Supabase Data API (supabase-js / @supabase/ssr)
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://tphctdpigzuesjxhrwjv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Storage-Uploads der Wareneingangs-Belege (privater Bucket "belege") und
# `npm run benutzer` (Konten über die Admin-API anlegen, siehe docs/anmeldung.md).
# Reines Server-Geheimnis: nie NEXT_PUBLIC, nie aus 'use client'-Dateien
# importieren. Dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Laufende App: Transaction pooler, Port 6543 (viele kurze Anfragen).
# pgbouncer=true schaltet Prismas Prepared Statements ab — im Transaction-Mode Pflicht.
# Sonderzeichen im Passwort müssen prozent-kodiert werden.
DATABASE_URL=postgresql://prisma.tphctdpigzuesjxhrwjv:PASSWORT@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrationen (drizzle-kit): Session pooler, Port 5432.
DIRECT_URL=postgresql://prisma.tphctdpigzuesjxhrwjv:PASSWORT@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
