# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# lokale HTTPS-Zertifikate fürs Lager (Schlüssel gehören nie ins Repo)
/zertifikate

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# prisma (generierter Client — wird per postinstall neu erzeugt)
/src/generated

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (persönliche Einstellungen dieser Maschine, enthalten Projekt-Keys)
.claude/settings.local.json
